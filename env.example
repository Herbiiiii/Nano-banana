# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nano_banana
POSTGRES_USER=nano_banana_user
POSTGRES_PASSWORD=ВАШ_СИЛЬНЫЙ_ПАРОЛЬ  # ⚠️ ИЗМЕНИТЬ!

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin  # ⚠️ ИЗМЕНИТЬ!
MINIO_ROOT_PASSWORD=minioadmin123  # ⚠️ ИЗМЕНИТЬ!
MINIO_ACCESS_KEY=minioadmin  # ⚠️ ИЗМЕНИТЬ!
MINIO_SECRET_KEY=minioadmin123  # ⚠️ ИЗМЕНИТЬ!
MINIO_BUCKET=nano-banana-images
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# Security
SECRET_KEY=ВАШ_СГЕНЕРИРОВАННЫЙ_КЛЮЧ_64_СИМВОЛА  # ⚠️ ИЗМЕНИТЬ!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7
PWD_SCHEMES=bcrypt

# BananaHub API (ранее api.bananalab.pw → bananahub.io → bananahub.app)
BANANALAB_API_BASE_URL=https://bananahub.app/api
BANANALAB_BASE_URL=https://bananahub.app/api
# Автоповторы при «Upstream returned no image» (тот же промпт)
BANANALAB_UPSTREAM_NO_IMAGE_MAX_RETRIES=5
BANANALAB_UPSTREAM_NO_IMAGE_RETRY_BASE_DELAY_SECONDS=3

# OpenRouter (опционально — для заголовков HTTP-Referer / X-Title)
OPENROUTER_HTTP_REFERER=https://your-domain.example
OPENROUTER_X_TITLE=Nano Banana Pro

# API key (поле в коде называется REPLICATE_API_TOKEN для обратной совместимости)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Performance
MAX_WORKERS=3
MAX_CONCURRENT_GENERATIONS=3

# CORS (добавьте!)
CORS_ORIGINS=*  # ⚠️ Для продакшена: https://yourdomain.com
SECURITY_STRICT_CSP=true
SECURITY_ENABLE_HSTS=true
SECURITY_LOGIN_MAX_ATTEMPTS=10
SECURITY_LOGIN_WINDOW_SECONDS=300
SECURITY_ADMIN_READ_MAX_REQUESTS=120
SECURITY_ADMIN_READ_WINDOW_SECONDS=60
SECURITY_CSP_ALLOW_INLINE_SCRIPTS=true
SECURITY_CSP_ALLOW_MINIO_CONSOLE_FRAME=false
# На проде: true (скрывает /docs и /openapi.json). Локально: false
SECURITY_DISABLE_OPENAPI=false
SECURITY_REGISTER_MAX_ATTEMPTS=10
SECURITY_REGISTER_WINDOW_SECONDS=3600
# Доп. хосты для URL референсов (через запятую), если MinIO на другом домене
SECURITY_ALLOWED_REF_URL_HOSTS=

# API URLs (добавьте!)
API_URL=http://localhost:8000
# Для продакшена: https://storage.ooneclickk.ru/console
# Для локальной разработки: http://localhost:9001
MINIO_CONSOLE_URL=http://localhost:9001